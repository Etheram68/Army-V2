generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          Role      @default(RESERVISTE)
  groupId       String?
  group         Group?    @relation(fields: [groupId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  participations Participation[]
  missionsCreated Mission[] @relation("UserCreatedMissions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Compagnie {
  id       String    @id @default(cuid())
  name     String
  sections Section[]
  missions Mission[] @relation("CompagnieMissions")
}

model Section {
  id           String    @id @default(cuid())
  name         String
  compagnieId  String
  compagnie    Compagnie @relation(fields: [compagnieId], references: [id])
  groupes      Group[]
  missions     Mission[] @relation("SectionMissions")
}

model Group {
  id         String   @id @default(cuid())
  name       String
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id])
  members    User[]
  missions   Mission[] @relation("GroupMissions")
}

model Mission {
  id           String     @id @default(cuid())
  title        String
  description  String?
  startDate   DateTime
  endDate     DateTime
  visibility   MissionVisibility
  createdById  String
  createdBy    User       @relation("UserCreatedMissions", fields: [createdById], references: [id])
  groupId      String?
  group        Group?     @relation("GroupMissions", fields: [groupId], references: [id])
  sectionId    String?
  section      Section?   @relation("SectionMissions", fields: [sectionId], references: [id])
  compagnieId  String?
  compagnie    Compagnie? @relation("CompagnieMissions", fields: [compagnieId], references: [id])
  participations Participation[]
}

model Participation {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  missionId  String
  mission    Mission    @relation(fields: [missionId], references: [id])
  status     ParticipationStatus
  updatedAt  DateTime   @updatedAt

  @@unique([userId, missionId])
}

enum Role {
  RESERVISTE
  CHEF_GROUPE
  CHEF_SECTION
  COMMANDANT_UNITE
}

enum MissionVisibility {
  GROUPE
  SECTION
  COMPAGNIE
}

enum ParticipationStatus {
  PRESENT
  ABSENT
  INDEFINI
}